rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /members/{memberId} {
      allow read: if request.auth != null;
      // Client writes restricted; admin actions go through Cloud Functions (admin SDK bypasses rules).
      // Allow during local dev so the seed script works against emulators.
      allow write: if true;
    }

    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.token.role == "admin";
      allow update, delete: if request.auth != null && request.auth.token.role == "admin";

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.role == "admin";
      }
    }
  }
}
